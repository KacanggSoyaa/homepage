# Dependencies
node_modules

# Build output
dist

# Tooling session state (opencode/omo) — never commit these
.omo/

# Vite dev-server dependency cache (regenerated by npm run dev)
.vite/

# Environment / secrets — add real .env files, keep only a safe .env.example
.env
.env.*
!.env.example

# Local files
*.local

# Source images that are only ever an input to a conversion step. The build uses
# the generated .jpg, so committing the multi-megabyte .heic original would just
# bloat the repository. Keep yours locally as the master.
*.heic
*.heif

# Audio for the music page. The tracks are recordings you don't own the rights
# to redistribute, so they stay out of the repository. The Pages workflow builds
# from the repo, so it has no audio either — the site is pointed at a separately
# hosted copy of this tree via VITE_AUDIO_BASE, and this folder is the local
# working copy of it. See "Where the audio lives" in README.md.
#
# The .txt notes in a playlist folder are deliberately not matched here, so they
# stay tracked.
public/audio/*/*.mp3
public/audio/*/*.m4a
public/audio/*/*.flac
public/audio/*/*.wav
public/audio/*/*.ogg
public/audio/*/*.opus
public/audio/*/*.aac
public/audio/*/*.webm

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini